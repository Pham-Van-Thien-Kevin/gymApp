# Kopieer dit bestand naar .env.local en vul je eigen waarden in.
# Je vindt ze in Supabase: Project Settings → API Keys (en Data API voor de URL).

NEXT_PUBLIC_SUPABASE_URL=https://jouw-project-id.supabase.co
# De publieke "publishable" key (sb_publishable_...). Een oudere "anon" key werkt ook.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optioneel: de publieke URL van je app, gebruikt in de bevestigingsmail.
# Laat leeg om automatisch de huidige host te gebruiken.
# NEXT_PUBLIC_SITE_URL=https://jouw-app.vercel.app
